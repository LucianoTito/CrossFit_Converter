<?xml version="1.0" encoding="utf-8"?>
<!--
  Kalibra no respalda nada.

  Lo unico que guarda son las preferencias de la interfaz (division elegida,
  ultimas unidades) en el almacenamiento del WebView. Son datos triviales que
  se regeneran solos al usar la app, asi que no hay razon para mandarlos a la
  nube ni para transferirlos entre dispositivos. Menos datos saliendo del
  telefono es menos superficie expuesta.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
